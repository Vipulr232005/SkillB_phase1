# Resend email (copy to .env and fill in your values)
# Get API key: https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified domain sender, or Resend test sender for dev:
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Google OAuth (Cloud Console → Credentials → OAuth client ID, type Web)
# Redirect: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Settings → Developer settings → OAuth Apps)
# Callback: http://localhost:8000/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gemini AI for session summaries (aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Jitsi (self-hosted) ---
JITSI_BASE_URL=http://localhost:8443
JITSI_APP_ID=skillbridge
JITSI_JWT_SECRET=

# --- Transcription ---
STT_PROVIDER=gemini
# WHISPER is a future swap — leave blank until an OpenAI account is set up:
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- Storage ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Async task queue ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# For local dev without Redis/Celery: set CELERY_TASK_ALWAYS_EAGER=true to run tasks synchronously
# CELERY_TASK_ALWAYS_EAGER=true

# --- Resend is already above ---
